{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2023",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@gdp/core": ["../../packages/core/src/index.ts"],
      "@gdp/core/*": ["../../packages/core/src/*"],
      "@gdp/design-schema": ["../../packages/design-schema/src/index.ts"],
      "@gdp/design-schema/*": ["../../packages/design-schema/src/*"],
      "@gdp/fonts": ["../../packages/fonts/src/index.ts"],
      "@gdp/fonts/*": ["../../packages/fonts/src/*"],
      "@gdp/typography": ["../../packages/typography/src/index.ts"],
      "@gdp/layout-engine": ["../../packages/layout-engine/src/index.ts"],
      "@gdp/renderer": ["../../packages/renderer/src/index.ts"],
      "@gdp/design-dna": ["../../packages/design-dna/src/index.ts"],
      "@gdp/planner": ["../../packages/planner/src/index.ts"],
      "@gdp/planner/*": ["../../packages/planner/src/*"],
      "@gdp/qa": ["../../packages/qa/src/index.ts"],
      "@gdp/retrieval": ["../../packages/retrieval/src/index.ts"],
      "@gdp/db": ["../../packages/db/src/index.ts"],
      "@gdp/db/*": ["../../packages/db/src/*"],
      "@gdp/storage": ["../../packages/storage/src/index.ts"],
      "@gdp/web": ["./src/index.ts"],
      "@gdp/web/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
